# ==============================================================================
# PredictIQ Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' for local development.
# Never commit '.env' or any credentials into version control.
# ==============================================================================

# Application Environment Mode
# Allowed values: development, testing, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base Paths (Leave empty to use default repository relative paths)
# DATA_DIR=
# ARTIFACTS_DIR=

# PostgreSQL Database Configuration
POSTGRES_USER=predictiq
POSTGRES_PASSWORD=predictiq_dev_password
POSTGRES_DB=predictiq_mlflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MLflow Tracking Server Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=predictiq-default
MLFLOW_PORT=5000
MLFLOW_ARTIFACT_DESTINATION=/mlflow/artifacts
