# ==============================================================================
# PredictIQ — Docker Build Ignore Configuration
# ==============================================================================

# Git and Version Control
.git/
.gitignore
.gitattributes

# Virtual Environments
.venv/
venv/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Secrets and Local Configurations
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Data Layer (Raw, processed, external excluded; cleaned dataset included for dashboard)
data/raw/
data/interim/*
!data/interim/Telco-Customer-Churn-cleaned.csv
data/processed/
data/external/

# Testing and Coverage
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
pytestdebug.log

# Jupyter Notebooks
notebooks/
.ipynb_checkpoints

# MLflow & Database Local Mounts
mlruns/
mlartifacts/
postgres_data/

# Logs and Scratch Files
logs/
*.log
scratch/
tmp/
artifacts/

# Documentation source markdown (not needed inside container)
docs/
